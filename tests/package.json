{
  "name": "oql-tests",
  "type": "module",
  "private": true,
  "dependencies": {
    "@vinctus/oql-pg": "file:../pg/npm",
    "@vinctus/oql-petradb": "file:../petradb/npm",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4"
  },
  "scripts": {
    "test": "tsx global-setup.ts && node --test --import tsx *.test.ts",
    "test:pg": "OQL_BACKEND=pg npm test",
    "test:petradb": "OQL_BACKEND=petradb npm test",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down"
  }
}
